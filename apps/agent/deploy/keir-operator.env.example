# /etc/keir-operator.env, root:root 0600. Never commit the real file.
KEIR_OPERATOR_ADMIN_TOKEN=replace-with-random-token
KEIR_OPERATOR_PORT=9765
# Optional overrides (defaults shown):
# All Keir model lanes use Cursor Auto through the authenticated Cursor CLI.
KEIR_QUICK_PROVIDER=cursor:auto
KEIR_WORKER_PROVIDER=cursor:auto
KEIR_CODING_PROVIDER=cursor:auto
KEIR_INVESTIGATOR_PROVIDER=cursor:auto
KEIR_ENGINEERING_PROVIDER=cursor:auto
KEIR_WATCHKEEPER_PROVIDER=cursor:auto
KEIR_VISION_PROVIDER=cursor:auto
KEIR_VOICE_PROVIDER=cursor:auto
KEIR_DYNAMIC_EFFORT=0
# Optional Claude runner fallback model, only when explicitly selecting Claude.
# KEIR_MODEL=claude-opus-5-5
KEIR_WORKERS=6
# KEIR_MAX_INTAKE_PER_HOUR=4
# KEIR_CLOSE_GRACE_MINUTES=60
# KEIR_MAX_TURN_MINUTES=15
# KEIR_MAX_TOOL_ROUNDS=24
# KEIR_TASK_LIFETIME_HOURS=168
# KEIR_SCAN_EXCLUDE=<comma-separated channel ids not to watch>
# The model runs on the owner's Claude subscription via the claude CLI.
# Do not add an Anthropic API key here or to any Keir unit.

# Optional desktop integration: JSON map of additional server names to read-tool arrays.
KEIR_DESKTOP_READ_TOOLS={}
# Optional project manifest, with entries keyed by name and a path per entry.
KEIR_PROJECTS_MANIFEST=

# Experimental source-grounded knowledge preparation. Disabled by default.
# Uses the existing scoped broker; quick/voice activations skip preparation.
# KEIR_KNOWLEDGE_PREPARE=1
# KEIR_KNOWLEDGE_PROJECT=a-house-divided
# KEIR_KNOWLEDGE_SERVER=ops-knowledge
# KEIR_KNOWLEDGE_TIMEOUT_MS=5000
# Experimental idle repair of verified public game-mechanics KB documents.
# Source rechecks, expectedVersion saves and durable receipts guard each edit.
# KEIR_KNOWLEDGE_CORRECT=1

[Unit]
Description=Keir durable owner operator and Discord support desk
After=network-online.target
Wants=network-online.target
# 8.4: a crash loop stops after 5 failures in 5 minutes and the unit goes `failed`;
# keir-guardian then restarts it with backoff and alerts the owner if it keeps failing.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/keir/current
EnvironmentFile=/etc/keir-discord.env
EnvironmentFile=/etc/keir-operator.env
EnvironmentFile=-/etc/keir-sentry.env
ExecStart=/usr/bin/node /opt/keir/current/operator.js
Restart=on-failure
RestartSec=10
StateDirectory=keir-operator
StateDirectoryMode=0700
UMask=0077
MemoryHigh=20G
MemoryMax=24G
CPUQuota=600%
CPUWeight=500
TasksMax=2048
# mixed: SIGTERM reaches only the operator, so its 100 s grace lets running
# activations finish; their CLI children are killed only after it exits.
# control-group sent SIGTERM to the children too, which ended every running
# activation at once and left its ticket blocked (2026-11-01, tickets 1730, 1740).
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

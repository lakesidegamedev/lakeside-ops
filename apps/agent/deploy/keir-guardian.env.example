# /etc/keir-guardian.env, root:root 0600, optional. Defaults shown.
# KEIR_GUARDIAN_UNITS=keir-operator,keir-summon,keir-inbox
# KEIR_GUARDIAN_TIMERS=keir-watchkeeper.timer,keir-conversation-audit.timer,keir-self-review.timer,keir-shadow.timer
# KEIR_GUARDIAN_MAX_RESTARTS=3
# KEIR_GUARDIAN_HANG_GRACE_MS=300000
# Touch /var/lib/keir-guardian/disabled to make the guardian do nothing (it still never starts a stopped unit).

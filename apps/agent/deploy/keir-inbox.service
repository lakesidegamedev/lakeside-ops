[Unit]
Description=Keir DM inbox and reward claims (ops dashboard /inbox)
After=network-online.target
Wants=network-online.target
# 8.4: a crash loop stops after 5 failures in 5 minutes and the unit goes `failed`;
# keir-guardian then restarts it with backoff and alerts the owner if it keeps failing.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/keir/current
EnvironmentFile=/etc/keir-discord.env
EnvironmentFile=/etc/keir-inbox.env
Environment=HOME=/root
Environment=NODE_ENV=production
Environment=NODE_NO_WARNINGS=1
ExecStart=/usr/bin/node /opt/keir/current/inbox.js
Restart=on-failure
RestartSec=10
StateDirectory=keir-inbox
StateDirectoryMode=0700
UMask=0077
MemoryMax=1G
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

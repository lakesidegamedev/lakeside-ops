  "priority": [
    "error",
    "fuming",
    "alert",
    "gloom",
    "thinking",
    "working",
    "talking",
    "celebrate",
    "idea",
    "thumbs_up",
    "waking",
    "listening",
    "reading",
    "sleeping",
    "idle"
  ],
  "idle_variety": {
    "every_s": [
      18,
      40
    ],
    "pick_from": [
      "blink",
      "glasses_peek",
      "glasses_glint",
      "wink",
      "tea_sip",
      "brow_wiggle",
      "humming"
    ],
    "blink_every_s": [
      3,
      6

  "states": {
    "idle": {
      "row": 0,
      "frames": 8,
      "fps": 8,
      "loop": true,
      "group": "core",
      "trigger": "default resting state"
    },
    "blink": {
      "row": 1,
      "frames": 3,
      "fps": 12,
      "loop": false,
      "group": "core",
      "trigger": "one-shot, every 3-6s from idle"

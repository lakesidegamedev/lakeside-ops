    "talking": {
      "row": 2,
      "frames": 6,
      "fps": 10,
      "loop": true,
      "group": "core",
      "trigger": "a new line is arriving; run for the reveal"
    },
    "listening": {
      "row": 3,
      "frames": 6,
      "fps": 6,
      "loop": true,
      "group": "core",
      "trigger": "owner typing / voice input open"
    },
    "thinking": {
      "row": 4,
      "frames": 6,
      "fps": 6,
      "loop": true,
      "group": "core",
      "trigger": "refresh or model generation in flight"

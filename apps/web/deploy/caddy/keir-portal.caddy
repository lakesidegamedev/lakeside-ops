# Optional static-portal publication for an independent studio host.
# The unified studio deployment does NOT import this: apps/web/portal/studio.js
# serves /keir/app, /portal.js, /portal.css and /api/portal/config from the ops
# release under the same SSO session. Use this file only when publishing the
# portal from /opt/keir/portal separately. /api/keir/app/* remains on the
# authenticated Keir upstream.
@keir_portal path /keir/app /portal.js /portal.css /api/portal/config
route @keir_portal {
	root * /opt/keir/portal/current
	@keir_index path /keir/app
	rewrite @keir_index /index.html
	@keir_config path /api/portal/config
	rewrite @keir_config /config.json
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"
	}
	file_server
}
